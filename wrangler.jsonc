{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tv",
  "main": "src/cf-entry.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "tv.ycxdev.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "DEFAULT_SOURCES": "[{\"name\":\"暴风资源\",\"url\":\"https://bfzyapi.com/api.php/provide/vod\",\"isAdult\":false,\"tier\":1},{\"name\":\"最大资源\",\"url\":\"https://api.zuidapi.com/api.php/provide/vod\",\"isAdult\":false,\"tier\":1},{\"name\":\"量子资源\",\"url\":\"https://cj.lziapi.com/api.php/provide/vod\",\"isAdult\":false,\"tier\":1},{\"name\":\"金鹰资源\",\"url\":\"https://jyzyapi.com/api.php/provide/vod\",\"isAdult\":false,\"tier\":1},{\"name\":\"如意资源\",\"url\":\"https://cj.rycjapi.com/api.php/provide/vod\",\"isAdult\":false,\"tier\":1},{\"name\":\"无尽资源\",\"url\":\"https://api.wujinapi.me/api.php/provide/vod\",\"isAdult\":false,\"tier\":1},{\"name\":\"爱坤资源\",\"url\":\"https://ikunzyapi.com/api.php/provide/vod\",\"isAdult\":false,\"tier\":1},{\"name\":\"红牛资源\",\"url\":\"https://www.hongniuzy2.com/api.php/provide/vod\",\"isAdult\":false,\"tier\":1},{\"name\":\"360资源\",\"url\":\"https://360zy.com/api.php/provide/vod\",\"isAdult\":false},{\"name\":\"1080资源库\",\"url\":\"https://api.1080zyku.com/inc/apijson.php\",\"isAdult\":false},{\"name\":\"乐播\",\"url\":\"https://lbapi9.com/api.php/provide/vod\",\"isAdult\":true},{\"name\":\"鲨鱼\",\"url\":\"https://shayuapi.com/api.php/provide/vod\",\"isAdult\":true},{\"name\":\"大地\",\"url\":\"https://dadiapi.com/api.php/provide/vod\",\"isAdult\":true},{\"name\":\"森林\",\"url\":\"https://slapibf.com/api.php/provide/vod\",\"isAdult\":true},{\"name\":\"废柴\",\"url\":\"https://fhapi9.com/api.php/provide/vod\",\"isAdult\":true},{\"name\":\"辣椒\",\"url\":\"http://api.11bat.com/api.php/provide/vod\",\"isAdult\":true},{\"name\":\"玉兔资源\",\"url\":\"https://apiyutu.com/api.php/provide/vod\",\"isAdult\":true},{\"name\":\"155\",\"url\":\"https://155api.com/api.php/provide/vod\",\"isAdult\":true},{\"name\":\"魔法\",\"url\":\"https://madouse.la/api.php/provide/vod\",\"isAdult\":true},{\"name\":\"精品下\",\"url\":\"https://www.jingpinx.com/api.php/provide/vod\",\"isAdult\":true}]",
    "DEFAULT_LIVE_SOURCES": "[{\"name\":\"GNTV 港台/国际/地方\",\"url\":\"https://raw.githubusercontent.com/YueChan/Live/main/GNTV.m3u\"},{\"name\":\"iptv-org 全球\",\"url\":\"https://iptv-org.github.io/iptv/index.m3u\"},{\"name\":\"iptv-org 新闻\",\"url\":\"https://iptv-org.github.io/iptv/categories/news.m3u\"},{\"name\":\"iptv-org 体育\",\"url\":\"https://iptv-org.github.io/iptv/categories/sports.m3u\"},{\"name\":\"Collect-IPTV 省台/轮播\",\"url\":\"https://raw.githubusercontent.com/zilong7728/Collect-IPTV/refs/heads/main/best_sorted.m3u\"},{\"name\":\"海外 FAST 频道\",\"url\":\"https://raw.githubusercontent.com/akiralereal/iptv/main/IPTV-overseas.m3u\"},{\"name\":\"Guovin 央视/卫视 IPv4\",\"url\":\"https://raw.githubusercontent.com/Guovin/iptv-api/gd/output/ipv4/result.m3u\"},{\"name\":\"Guovin 综合\",\"url\":\"https://raw.githubusercontent.com/Guovin/iptv-api/gd/output/result.m3u\"},{\"name\":\"iptv-org 电影\",\"url\":\"https://iptv-org.github.io/iptv/categories/movies.m3u\"},{\"name\":\"zbds 央视/卫视\",\"url\":\"https://live.zbds.top/tv/iptv4.m3u\"}]",
